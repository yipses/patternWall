{
  "name": "patternwall",
  "version": "1.0.0",
  "private": true,
  "description": "PatternWall - a generative iPhone wallpaper studio.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspace @patternwall/core",
    "build": "npm run build --workspace @patternwall/core && npm run build --workspace @patternwall/web",
    "dev": "npm run dev --workspace @patternwall/web",
    "test:e2e": "npm run test:e2e --workspace @patternwall/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
